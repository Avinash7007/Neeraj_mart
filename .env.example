# Server Configuration
PORT=3000
NODE_ENV=development

# ==============================================================================
# Hostinger MySQL / Cloud Database Configuration
# ==============================================================================
# In Hostinger hPanel -> Databases -> MySQL Databases / Remote MySQL:
# 1. Ensure you create a database and user with ALL PRIVILEGES.
# 2. In "Remote MySQL", add "%" (or your app server IP) to allow remote access.
# ==============================================================================
MYSQL_HOST=srvXXXX.hstgr.io
MYSQL_PORT=3306
MYSQL_USER=u123456789_storeuser
MYSQL_PASSWORD=YourStrongPasswordHere
MYSQL_DATABASE=u123456789_storedb
MYSQL_SSL=true

# Alternative Standard Database Environment Variables (Also supported)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=general_store_db

# Or Full Connection URI (Optional)
# DATABASE_URL=mysql://u123456789_storeuser:YourPassword@srvXXXX.hstgr.io:3306/u123456789_storedb

# Firebase Configuration (for Admin ID Token Verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL=your-client-email

# Admin Portal Master Security PIN / Passcode (Server-side secret)
ADMIN_PIN=

